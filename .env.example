# Committed with empty values. To rebuild .env on a new machine, ask for one value per key.
# What goes where: skills/stable/repo-context-audit/references/env-file.md

# what: short name of the client behind the oldest engagement | group: clients
CLIENT_A=
# what: another written form of that same client's name | group: clients
CLIENT_B=
# what: short name of the client behind the warehouse engagement | group: clients
CLIENT_C=
# what: short name of the client behind the newest engagement | group: clients
CLIENT_D=
# what: longer form of that newest client's name | group: clients
CLIENT_E=

# what: repo name from the oldest engagement | group: repos
REPO_A=
# what: repo name from the warehouse engagement | group: repos
REPO_B=
# what: name of the slice copied out for the promotion trial | group: repos
SLICE_A=
# what: repo name whose topic folders held the big extracted trees | group: repos
TREE_REPO=

# what: folder name of the largest tree extracted from an image in that repo | group: trees
TREE_A=
# what: folder name of the second largest extracted tree there | group: trees
TREE_B=
# what: folder name of the third largest extracted tree there | group: trees
TREE_C=

# what: SSH alias of the devcontainer for side projects; an ordinary word, so a hit warns | group: fleet | match: warn
DEPLOY_HOST_1=
# what: SSH alias of a machine that scripts/deploy-plugins.sh updates; add a key per machine | group: fleet
DEPLOY_HOST_2=
DEPLOY_HOST_3=
DEPLOY_HOST_4=
DEPLOY_HOST_5=
