[# sql_appendix.j2 — SQL block with file:line citation header.
   Pattern: '### Q<n>: <one-line intent>' over a code_expand block.

   Variables expected in scope:
     q_label:    short label (e.g. 'Q1')
     q_intent:   one-line intent (e.g. 'per-product SUM parity check')
     sql_path:   path to .sql file, relative to frontmatter.root_path
     sql_lines:  line range string (e.g. '120-185') or [N, M] array; omit to include whole file

   GOTCHA: dbt-Jinja `{{ ref('...') }}` inside the SQL renders as literal text
   thanks to custom [[ ]] / [% %] template delimiters — see ARCHITECTURE.md.
#]

### [[ q_label ]]: [[ q_intent ]]

[[ sql_path | code_expand(lines=sql_lines) ]]
